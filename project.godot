[application]

config/name="BEKALAND"
run/main_scene="uid://cdc48ryq1kire"
config/use_custom_user_dir=true
config/custom_user_dir_name=".bekaland"
config/features=PackedStringArray("4.7", "Forward Plus")
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=5
boot_splash/use_filter=false
boot_splash/image="uid://55v4d4vqgd6"
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dcvpvhold26xm"

[autoload]

_G="*uid://culqh4nn5ui03"
_C="*uid://bigw5his8ewsr"
_F="*uid://dge75o602kxnk"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/int_as_enum_without_cast=0
gdscript/warnings/int_as_enum_without_match=0

[display]

window/size/viewport_width=640
window/size/viewport_height=512
window/size/borderless=true
window/size/window_width_override=1280
window/size/window_height_override=1024
window/stretch/mode="viewport"
window/stretch/aspect="ignore"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[global_group]

Destroyable="Something the player can destroy"
Entity="Something the player can damage"
Pickup=""

[gui]

theme/custom_font="uid://b5ph3pv1f2qph"

